# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA faça commit do arquivo .env com chaves reais.

# Chave exigida no header X-API-Key (o jogo e o painel enviam essa chave)
CC_API_KEY=cc-dev-key-troque-me

# Ollama rodando localmente com o modelo Llama 3.2  (ollama pull llama3.2)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60

# Se true, a API devolve texto procedural (fonte="fallback") quando o Ollama está fora do ar
FALLBACK_HABILITADO=true

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8501
